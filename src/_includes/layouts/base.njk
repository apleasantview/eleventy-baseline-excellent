<!doctype html>
<html lang="{{ page.lang or 'en' }}">
  {#
    Baseline composes the whole <head>: charset, viewport, title, description,
    robots, canonical, Open Graph and the JSON-LD graph. Head order is handled by
    capo.js, which is what the hand-sequenced includes used to do by hand.

    Everything below the placeholder is a sibling, not a child — children are
    discarded. The parser's "after head" insertion mode folds base, link, meta,
    script, style and title back into the head element, so these still land in
    the right place while bypassing Baseline's pipeline.
  #}
  <baseline-head></baseline-head>

  <!-- dedupe keys on `name`, so these two would collapse into one -->
  <meta name="theme-color" content="{{ meta.themeDark }}" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="{{ meta.themeLight }}" media="(prefers-color-scheme: light)" />

  {#
    Per-post share card. It cannot come from data: the SEO graph is assembled before
    `eleventyComputed` resolves, `ogImage: ''` in posts.11tydata.js stops Baseline emitting its own.
  #}
  {% if 'posts' in (tags or []) and slug %}
    <meta property="og:image" content="{{ ('/assets/og-images/' + slug + '-preview.jpeg') | url | absoluteUrl(settings.url) }}" />
    <meta property="og:image:alt" content="{{ title }}" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
  {% endif %}

  {#
    The asset sources are esbuild entries now, and esbuild does not render Nunjucks —
    a `{{ … }}` left in a script ships to the browser as a literal string. Anything the
    scripts need is handed in from the page instead.
  #}
  <script>
    window.__site = {
      themeDark: '{{ meta.themeDark }}',
      themeLight: '{{ meta.themeLight }}',
      navBreakpoint: '{{ designTokens.viewports.navigation }}'
    };
  </script>

  {# Critical path: inlined so the theme is on <html> before first paint. #}
  {% set jsThemeTogglePath = _baseline.paths.assets ~ "js/bundle/theme-toggle.js" %}
  {{ jsThemeTogglePath | inlineESbuild({ minify: true }) | safe }}

  {% include "head/meta-info.njk" %}

  <body class="{{ layout }}">
    {% set indicateActiveHome %}
      {% if page.url == "/" %}
        aria-current=page
      {% endif %}
    {% endset %}
    {% include "partials/header.njk" %}

    <main id="main" class="flow">{{ content | safe }}</main>

    {% include "partials/footer.njk" %}
    {%- if meta.easteregg -%}
      <script type="module" src="/assets/scripts/components/custom-easteregg.js"></script>
      <custom-easteregg></custom-easteregg>
    {%- endif -%}
  </body>
</html>
