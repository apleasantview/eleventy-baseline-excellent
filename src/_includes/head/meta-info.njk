{#
  What remains after the head swap. Baseline now emits description, robots,
  generator, canonical and the whole Open Graph payload.

  These are the data-driven leftovers, rendered as siblings below
  <baseline-head>. The parser's "after head" insertion mode folds base, link,
  meta, script, style and title back into the head element.
#}

{% if meta.author.me and meta.author.me.length %}
  <!-- rel=me profiles -->
  {% for url in meta.author.me %}
    <link rel="me" href="{{ url }}" />
  {% endfor %}
{% endif %}

{% if meta.author.fediverse %}
  <!-- fediverse creator tag -->
  <meta name="fediverse:creator" content="{{ meta.author.fediverse }}" />
{% endif %}

<!-- RSS Autodiscovery. Loops over meta.blog.feedLinks -->
{% for feedLink in meta.blog.feedLinks %}
  <link
    rel="alternate"
    type="{{ feedLink.type }}"
    title="{{ feedLink.title }}: {{ meta.siteName }}"
    href="{{ feedLink.url }}"
  />
{% endfor %}
